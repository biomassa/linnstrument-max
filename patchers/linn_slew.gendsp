					]
				}
			},
			{
				"box": {
					"code": "// linn.slew: linear slew in the audio domain. Each new input value is reached in a straight line\n// over ms; a change on the right inlet (linn.cv's note count) jumps straight to the input instead,\n// so a new note lands on its pitch while slides are smoothed. Third inlet: the slew time in ms\n// (a number; 0 = no slew).\nHistory y(0);\nHistory tgt(0);\nHistory dy(0);\nHistory rem(0);\nHistory last(0);\nslewms = max(0, in3);\nn = max(1, mstosamps(slewms));\njump = in2 != last;\nlast = in2;\nif (jump || slewms <= 0) {\n\ty = in1;\n\ttgt = in1;\n\trem = 0;\n} else if (in1 != tgt) {\n\ttgt = in1;\n\tdy = (in1 - y) / n;\n\trem = n;\n}\nif (rem > 0) {\n\ty = y + dy;\n\trem = rem - 1;\n\tif (rem <= 0) {\n\t\ty = tgt;\n\t}\n}\nout1 = y;",
					"fontface": 0,
					"fontname": "<Monospaced>",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "codebox",
					"numinlets": 3,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						30.0,
						60.0,
						560.0,
						400.0
					]
				}
			},
